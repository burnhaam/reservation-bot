# 에어비앤비 iCal 구독 URL
AIRBNB_ICAL_URL=

# 네이버 플레이스(업체) ID
NAVER_PLACE_ID=

# GitHub API (blocked.ics 자동 push)
GITHUB_TOKEN=

# Gemini API (3행시 생성 + 재고 메모 파싱 + 매핑 유사도 검사)
# 429(RESOURCE_EXHAUSTED) 시 _KEY → _BACKUP → _BACKUP2 → _BACKUP3 → _BACKUP4 순으로 전환.
# 빈 슬롯에서 체인 종료. 백업 키들은 선택사항.
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GEMINI_API_KEY_BACKUP2=
GEMINI_API_KEY_BACKUP3=
GEMINI_API_KEY_BACKUP4=

# Discord 알림 & 승인 봇
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
# 매핑 승인 버튼 메시지를 발송할 채널 ID (없으면 버튼 비활성)
DISCORD_CHANNEL_ID=
# 콤마 구분 사용자 ID 목록 — 비우면 누구나 버튼 클릭 가능
DISCORD_AUTHORIZED_USER_ID=
